# Passwords for the lab. Generated by setup.sh -- change freely.
NAGIOSADMIN_PASS=change-me
MARIADB_ROOT_PASSWORD=change-me
NAGIOS_DB_PASS=change-me

# ServiceNow Personal Developer Instance (leave blank for dry-run mode:
# alerts are only logged, no tickets are created).
# SNOW_INSTANCE is just the instance name, e.g. dev12345
# Wrap values containing special characters in single quotes.
SNOW_INSTANCE=
SNOW_USER=
SNOW_PASS=
# Optional: sys_id of an assignment group to set on new incidents
SNOW_ASSIGNMENT_GROUP_SYSID=
